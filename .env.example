# Copy to .env (never commit .env). No secrets belong in this file.
API_PORT=8787                   # API + mock server (dev). `npm start` serves app + API on this port.

# Runtime AI is DISABLED by default. The app works fully without it (manual + mock paths).
# To enable the optional real provider, set all three on the SERVER side only:
AI_PROVIDER=disabled            # disabled | anthropic
AI_MODEL=                       # required when AI_PROVIDER=anthropic; no default is assumed
ANTHROPIC_API_KEY=              # supplied through the environment; never paste into chat or commit
AI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=1500
AI_MAX_CALLS_PER_ENCOUNTER=10

# Intelehealth: only the bundled MOCK server is implemented. No real endpoint is configured.
INTELEHEALTH_MODE=mock          # mock (only supported value in this build)
MOCK_TOKEN_TTL_SECONDS=900
