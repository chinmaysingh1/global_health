{
  "name": "chw-msk-assessment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CHW-supervised musculoskeletal assessment companion app (evaluation build, synthetic data only)",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build && npm run build:server",
    "start": "node dist-server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "protocol:build": "tsx scripts/build-protocol.ts",
    "protocol:diff": "tsx scripts/diff-sources.ts",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=dist-server/index.mjs",
    "build:ios": "tsc --noEmit && VITE_STANDALONE=1 vite build --outDir dist-ios --emptyOutDir && cap sync ios",
    "ios:install": "node scripts/ios-install.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
