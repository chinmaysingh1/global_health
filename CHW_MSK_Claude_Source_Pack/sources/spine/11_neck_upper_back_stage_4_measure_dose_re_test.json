      "text": "NS4-1&gt;NS4-1c"
    },
    {
      "source_id": "rWECNSFkKrOGuJkRPvsQdP:1:7251",
      "type": "shape-with-text",
      "attributes": {
        "id": "1:7251",
        "x": "460",
        "y": "1042",
        "width": "380",
        "height": "222",
        "name": "ROUNDED_RECTANGLE"
      },
      "text": "START GENTLE\nPositions of ease, NX-B gentle movement, chin nods, short walks, education. Baseline limited to pain, PSFS and the Örebro screen."
    },
    {
      "source_id": "rWECNSFkKrOGuJkRPvsQdP:1:8346",
      "type": "connector",
      "attributes": {
        "id": "1:8346",
        "x": "650",
        "y": "938",
        "connectorStart": "1:7239",
