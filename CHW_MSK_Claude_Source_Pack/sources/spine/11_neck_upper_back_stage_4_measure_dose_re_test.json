        "connectorEndCap": "ARROW_LINES"
      },
      "text": "NS4-1a&gt;NS4-HI"
    },
    {
      "source_id": "rWECNSFkKrOGuJkRPvsQdP:1:7255",
      "type": "shape-with-text",
      "attributes": {
