        "connectorStart": "1:6795",
        "connectorStartCap": "NONE",
        "connectorEnd": "1:6799",
        "connectorEndCap": "ARROW_LINES"
      },
      "text": "LS4&gt;LS4-1"
    },
    {
      "source_id": "rWECNSFkKrOGuJkRPvsQdP:1:6803",
      "type": "shape-with-text",
      "attributes": {
        "id": "1:6803",
        "x": "460",
        "y": "796",
        "width": "380",
        "height": "165",
        "name": "ROUNDED_RECTANGLE"
      },
      "text": "HIGH: pain at rest or wakes you; small movements flare it; takes hours or until the next day to settle"
    },
