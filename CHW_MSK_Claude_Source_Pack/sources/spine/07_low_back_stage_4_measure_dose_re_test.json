    },
    {
      "source_id": "rWECNSFkKrOGuJkRPvsQdP:1:6815",
      "type": "shape-with-text",
      "attributes": {
        "id": "1:6815",
        "x": "460",
        "y": "1071",
        "width": "380",
        "height": "222",
        "name": "ROUNDED_RECTANGLE"
      },
      "text": "START GENTLE\nPositions of ease, the group’s easing movement (LX-A or LX-B), short walks, education. Baseline limited to pain, PSFS and the STarT Back tool."
    },
    {
      "source_id": "rWECNSFkKrOGuJkRPvsQdP:1:7806",
      "type": "connector",
      "attributes": {
        "id": "1:7806",
        "x": "650",
        "y": "967",
