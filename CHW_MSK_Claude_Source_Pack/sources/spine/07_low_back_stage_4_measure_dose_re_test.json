        "connectorEnd": "1:6815",
        "connectorEndCap": "ARROW_LINES"
      },
      "text": "LS4-1a&gt;LS4-HI"
    },
    {
      "source_id": "rWECNSFkKrOGuJkRPvsQdP:1:6819",
      "type": "shape-with-text",
      "attributes": {
