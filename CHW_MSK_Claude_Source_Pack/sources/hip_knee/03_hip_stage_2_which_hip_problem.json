        "width": "280",
        "height": "130",
        "name": "ROUNDED_RECTANGLE"
      },
      "text": "Buttock, or the back of the upper thigh"
    },
    {
      "source_id": "cNyP7TFyrcoIYVPUoQlMgw:5:852",
      "type": "shape-with-text",
