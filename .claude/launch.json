{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "msk-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "msk-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "start"
      ],
      "port": 8787
    },
    {
      "name": "msk-phone-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--outDir",
        "dist-ios",
        "--port",
        "4174",
        "--strictPort"
      ],
      "port": 4174
    },
    {
      "name": "msk-prod-alt",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "API_PORT=8790 node dist-server/index.mjs"
      ],
      "port": 8790
    }
  ]
}
